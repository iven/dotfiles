    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "mem0-plugins": {
      "source": {
        "source": "github",
        "repo": "mem0ai/mem0"
      }
    },
    "workmux": {
      "source": {
        "source": "github",
        "repo": "raine/workmux"
      }
    }
